    {
      "name": "closing a page in its settings is kept across a reload, and an archived page is offered for restore to an adult only and comes back closed",
      "members": {
        "parent": "adult",
        "kid": "child"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_updates__pages (id, title, about, status, closed_at, messages_visibility, created_by, created_at) VALUES (?, ?, ?, 'open', NULL, 'family', ?, datetime('now'))",
          "params": [
            "ui-p1",
            "Dad's recovery",
            "News from the ward.",
            "{{parent}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_updates__pages (id, title, about, status, closed_at, messages_visibility, created_by, created_at) VALUES (?, ?, ?, 'archived', '2026-01-01T00:00:00.000Z', 'family', ?, datetime('now'))",
          "params": [
            "ui-p2",
            "Last year's surgery",
            "News from the ward.",
            "{{parent}}"
          ]
        },
        {
          "action": "open",
          "as": "kid"
        },
        {
          "action": "expectVisible",
          "as": "kid",
          "selector": "[data-testid=\"page-card\"][data-page-id=\"ui-p1\"]"
        },
        {
          "action": "expectCount",
          "as": "kid",
          "selector": "[data-testid=\"archived-pages\"]",
          "count": 0
        },
        {
          "action": "expectCount",
          "as": "kid",
          "selector": "[data-testid=\"page-card\"][data-page-id=\"ui-p2\"]",
          "count": 0
        },
        {
          "action": "open",
          "as": "parent"
        },
        {
          "action": "expectVisible",
          "as": "parent",
          "selector": "[data-testid=\"page-card\"][data-page-id=\"ui-p1\"]"
        },
        {
          "action": "expectCount",
          "as": "parent",
          "selector": "[data-testid=\"page-card\"][data-page-id=\"ui-p1\"] [data-testid=\"page-closed\"]",
          "count": 0
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "[data-testid=\"page-card\"][data-page-id=\"ui-p1\"]"
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "[data-testid=\"page-settings\"]"
        },
        {
          "action": "expectVisible",
          "as": "parent",
          "selector": "[data-testid=\"delete-page\"]"
        },
        {
          "action": "select",
          "as": "parent",
          "selector": "[data-testid=\"field-status\"]",
          "value": "closed"
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "[data-testid=\"save-settings\"]"
        },
        {
          "action": "expectText",
          "as": "parent",
          "text": "Closed to new messages"
        },
        {
          "action": "reload",
          "as": "parent"
        },
        {
          "action": "expectVisible",
          "as": "parent",
          "selector": "[data-testid=\"page-card\"][data-page-id=\"ui-p1\"] [data-testid=\"page-closed\"]"
        },
        {
          "action": "expectCount",
          "as": "parent",
          "selector": "[data-testid=\"page-card\"][data-page-id=\"ui-p2\"]",
          "count": 0
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "[data-testid=\"archived-pages\"] summary"
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "[data-testid=\"archived-page\"][data-page-id=\"ui-p2\"] [data-testid=\"archived-page-restore\"]"
        },
        {
          "action": "expectVisible",
          "as": "parent",
          "selector": "[data-testid=\"page-card\"][data-page-id=\"ui-p2\"] [data-testid=\"page-closed\"]"
        },
        {
          "action": "expectCount",
          "as": "parent",
          "selector": "[data-testid=\"archived-pages\"]",
          "count": 0
        },
        {
          "action": "reload",
          "as": "parent"
        },
        {
          "action": "expectVisible",
          "as": "parent",
          "selector": "[data-testid=\"page-card\"][data-page-id=\"ui-p2\"] [data-testid=\"page-closed\"]"
        },
        {
          "action": "reload",
          "as": "kid"
        },
        {
          "action": "expectVisible",
          "as": "kid",
          "selector": "[data-testid=\"page-card\"][data-page-id=\"ui-p2\"]"
        }
      ]
