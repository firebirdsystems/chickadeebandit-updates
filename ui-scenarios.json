{
  "scenarios": [
    {
      "name": "a child reads the page but is offered no way to post, edit, share or remove; an adult is offered each, and an update they post is still there after a reload",
      "members": {
        "parent": "adult",
        "kid": "child"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_updates__pages (id, title, about, status, closed_at, messages_visibility, created_by, created_at) VALUES (?, ?, ?, 'open', NULL, 'family', ?, datetime('now'))",
          "params": [
            "ui-p1",
            "Dad's recovery",
            "News from the ward.",
            "{{parent}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_updates__entries (id, page_id, member_id, author_name, title, body, audience, created_at) VALUES (?, ?, ?, ?, ?, ?, 'everyone', datetime('now'))",
          "params": [
            "ui-e1",
            "ui-p1",
            "{{parent}}",
            "Parent",
            "Out of surgery",
            "It went as planned."
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_updates__entries (id, page_id, member_id, author_name, title, body, audience, created_at) VALUES (?, ?, ?, ?, ?, ?, 'family', datetime('now'))",
          "params": [
            "ui-e2",
            "ui-p1",
            "{{parent}}",
            "Parent",
            "What the surgeon said",
            "Six weeks of rest."
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_updates__messages (id, page_id, guest_name, guest_message, source, created_at) VALUES (?, ?, 'Aunt Rosa', 'Hugs from all of us.', 'external', datetime('now'))",
          "params": [
            "ui-m1",
            "ui-p1"
